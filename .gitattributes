# Default: store text files with LF line endings
* text=auto eol=lf

# Windows scripts should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix shell scripts should stay LF
*.sh text eol=lf
gradlew text eol=lf

# Gradle / Java / resources
*.gradle text eol=lf
*.properties text eol=lf
*.java text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.mcmeta text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ogg binary
*.wav binary
*.nbt binary
*.jar binary
*.zip binary
*.class binary
*.bbmodel binary